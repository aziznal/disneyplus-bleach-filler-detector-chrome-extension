{
  "manifest_version": 3,
  "name": "Bleach Filler Radar",
  "version": "1.0.0",
  "description": "Tells you whether the Bleach episode playing on Disney+ is filler, mixed, or manga canon, and when the next filler run starts.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://*.disneyplus.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Bleach Filler Radar",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://*.disneyplus.com/*"],
      "js": ["episodes.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
